VITE_TTS_USAGE_COLLECTION_ID=tts_usage

# Functions
VITE_APPWRITE_PROCESS_YOUTUBE_FUNCTION_ID=your_function_id
VITE_GEMINI_TTS_FUNCTION_ID=your_function_id
VITE_AI_PROXY_FUNCTION_ID=aiProxyUniversal

# ===========================================
# API KEYS (Client-side - be careful!)
# ===========================================
VITE_DEEPSEEK_API_KEY=your_deepseek_key
VITE_GEMINI_API_KEY=your_gemini_key
VITE_GROQ_API_KEY=your_groq_key

# ===========================================
# CLOUDFLARE R2 (Audio Storage)
# ===========================================
VITE_CLOUDFLARE_ACCOUNT_ID=your_account_id
VITE_CLOUDFLARE_R2_ACCESS_KEY_ID=your_access_key
VITE_CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_secret_key
VITE_CLOUDFLARE_R2_BUCKET_NAME=lastweek-audio
VITE_CLOUDFLARE_R2_PUBLIC_URL=https://your-bucket.r2.dev

# ===========================================
# PADDLE BILLING
# ===========================================
VITE_PADDLE_ENV=sandbox
VITE_PADDLE_ENVIRONMENT=sandbox
VITE_PADDLE_CLIENT_TOKEN=your_client_token
VITE_PADDLE_NOTIFICATION_ID=your_notification_id

# Price IDs
VITE_PADDLE_PRE_REG_PRICE_ID=your_pre_reg_price_id
VITE_PADDLE_PRO_PRICE_ID=your_pro_price_id
VITE_PADDLE_PLUS_PRICE_ID=your_plus_price_id
VITE_PADDLE_PROPLUS_PRICE_ID=your_proplus_price_id

# ===========================================
# SERVER-SIDE (for Appwrite Functions)
# DO NOT include VITE_ prefix - these are secrets!
# ===========================================
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_project_id
APPWRITE_DATABASE_ID=your_database_id
APPWRITE_API_KEY=your_server_api_key
DEEPSEEK_API_KEY=your_deepseek_key
PADDLE_PRE_REG_PRICE_ID=your_pre_reg_price_id
PADDLE_PRO_PRICE_ID=your_pro_price_id
PADDLE_PLUS_PRICE_ID=your_plus_price_id
PADDLE_PROPLUS_PRICE_ID=your_proplus_price_id
